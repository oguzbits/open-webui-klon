  "info": {
    "title": "Open WebUI Klon API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "pending",
              "user",
              "admin"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "name",
          "disabled",
          "createdAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "pending",
              "user",
              "admin"
            ],
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "role",
          "email",
          "name",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "role": {
            "enum": [
              "pending",
              "user",
              "admin"
            ],
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          }
        }
      },
      "SetUserPasswordDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "password"
        ]
      },
      "AuthConfigDto": {
        "type": "object",
        "properties": {
          "signupEnabled": {
            "type": "boolean"
          },
          "onboarding": {
            "type": "boolean"
          },
          "apiKeysEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "signupEnabled",
          "onboarding",
          "apiKeysEnabled"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "SessionInfoDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "csrfToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ApiKeyDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "nullable": true
          },
          "lastUsedAt": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "expiresAt",
          "lastUsedAt",
          "id",
          "name",
          "prefix",
          "createdAt"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "expiresInDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 365,
            "description": "Without a value the key never expires"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "CreatedApiKeyDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "nullable": true
          },
          "lastUsedAt": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "expiresAt",
          "lastUsedAt",
          "id",
          "name",
          "prefix",
          "createdAt",
          "key"
        ]
      },
      "ProviderConnectionDto": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "ollama",
              "openai_compatible"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "hasApiKey": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "hiddenModelIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "name",
          "baseUrl",
          "hasApiKey",
          "enabled",
          "hiddenModelIds",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProviderConnectionDto": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "ollama",
              "openai_compatible"
            ],
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "type",
          "name",
          "baseUrl"
        ]
      },
      "UpdateProviderConnectionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "apiKey": {
            "type": "string",
            "nullable": true
          },
          "enabled": {
            "type": "boolean"
          },
          "hiddenModelIds": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      },
      "ConnectionTestDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "modelCount": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "modelCount"
        ]
      },
      "AdminModelDto": {
        "type": "object",
        "properties": {
          "rawModelId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "rawModelId",
          "name",
          "hidden"
        ]
      },
      "AdminModelListDto": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminModelDto"
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "ModelDto": {
        "type": "object",
        "properties": {
          "providerType": {
            "enum": [
              "ollama",
              "openai_compatible"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          }
        },
        "required": [
          "providerType",
          "id",
          "name",
          "connectionId",
          "providerName"
        ]
      },
      "UnavailableConnectionDto": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "timeout",
              "unreachable",
              "unauthorized",
              "bad_response",
              "blocked_host"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "id",
          "name"
        ]
      },
      "ModelListDto": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelDto"
            }
          },
          "unavailableConnections": {
